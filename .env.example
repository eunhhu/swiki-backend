PORT=8000
DATABASE_URL="file:./db.sqlite"
YWS_PORT=8001
YWS_PATH="/yws"

# Google Gemini API key for embeddings
GEMINI_API_KEY="your_api_key_here"

# Grid / Browse configuration
# Maximum counts for browse/search to prevent abuse
GRID_MAX_N=200
GRID_MAX_K=20
GRID_MAX_C=200

# Grid placement strategy: 'nearest' (default) or 'spiral'
GRID_PLACEMENT=nearest

# Grid TTL cleanup (ms) and core radius to avoid holes near origin
GRID_TTL_MS=600000
GRID_CORE_RADIUS=2

# Persist grid layout to disk (path). Leave empty to disable.
GRID_PERSIST_PATH=./data/grid.json

# Admin token for /admin endpoints (set securely in production)
ADMIN_TOKEN=dev-admin-token

# Optional: allow CORS origins (comma separated)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
