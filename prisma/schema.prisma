// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator prismabox {
  provider = "prismabox"
  output   = "../src/types/prismabox"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id        String       @id @default(uuid())
  name      String
  users     User[]
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String
  roles       Role[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("users")
}

model Document {
  id           String @id @default(uuid())
  title        String
  contentMd    String
  words        Int @default(0)
  thumbnail    String? // Base64 Incoded image
  views        Int @default(0)
  embedding    Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())
  updatedCount Int @default(0)
  editable     Boolean @default(true)

  tags         Tag[]
  histories    History[]

  @@map("documents")
}

model History {
  id         String @id @default(uuid())
  contentMd  String
  writenBy   String
  createdAt  DateTime @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id])
}

enum TagType {
  STD_NUM // 학번
  MAJOR // 학과
  CUSTOM // 커스텀
}

model Tag {
  id        String @id @default(uuid())
  type      TagType
  content   String @unique

  documents Document[]

  @@map("tags")
}