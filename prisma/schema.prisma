// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator prismabox {
  provider = "prismabox"
  output   = "../src/types/prismabox"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id        String       @id @default(uuid())
  name      String
  users     User[]
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String
  roles       Role[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("users")
}